# ============================================================================
# 环境变量示例文件
# 用法: 复制本文件为 .env 并填入真实值 (cp .env.example .env)
# 注意: .env 已被 gitignore, 绝不要提交到仓库!
# ============================================================================

# ----------------------------------------------------------------------------
# Android 签名 (scripts/build_android.ps1 使用)
# ----------------------------------------------------------------------------

# 密钥库 (release.keystore) 的 store 密码
# 未设置时构建脚本会回退到默认值 "android"
ANDROID_KEYSTORE_PASS=

# 签名 key 的密码 (通常与密钥库密码相同)
# 未设置时构建脚本会回退到默认值 "android"
ANDROID_KEY_PASS=

# ----------------------------------------------------------------------------
# 密钥库备份加密 (scripts/keystore-crypt.mjs 使用)
# ----------------------------------------------------------------------------

# release.keystore 备份文件的加密/解密密钥 (至少 8 个字符)
#   npm run keystore:encrypt  ->  release.keystore.enc (可提交到 git)
#   npm run keystore:decrypt  ->  release.keystore (覆盖本地)
# ⚠️ 务必在仓库之外 (如密码管理器) 备份此密钥, 丢失将无法从 .enc 文件恢复密钥库!
# 查看密钥指纹以核对多台机器是否用同一密钥: 脚本运行时会打印
KEYSTORE_ENC_KEY=

# ----------------------------------------------------------------------------
# 说明: 以下相关变量不需要写在 .env 里
# - ANDROID_KEYSTORE_PATH / ANDROID_KEYSTORE_PASSWORD / ANDROID_KEY_ALIAS /
#   ANDROID_KEY_PASSWORD: 由 build_android.ps1 读取上面的值后自动设置 (Gradle 约定名)
# - CI (GitHub Actions) 中签名密码来自仓库 Secrets: ANDROID_KEYSTORE_PASSWORD / ANDROID_KEY_PASSWORD
# ============================================================================
